NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0

# Local development and CI configuration
DATABASE_URL=postgresql://careflow:careflow_dev@localhost:5432/careflow
DB_SSL=false

# AWS ECS configuration
# DATABASE_URL is omitted in AWS.
# DB_HOST is supplied by Terraform.
# DB_PORT=5432
# DB_NAME=careflow
# DB_USER is injected from Secrets Manager.
# DB_PASSWORD is injected from Secrets Manager.
# DB_SSL=true
# DB_SSL_CA_PATH=/app/certs/global-bundle.pem
